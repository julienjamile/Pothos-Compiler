{
  "name": "Pothos",
  "fileExtension": ".pths",
  "caseSensitive": true,
  "keywords": [
    "strina", "wharfa", "flo", "inflo", "trua", "lis",
    "glossare","prin","inpub", "formo", "innum",
    "Trua", "Inaccu", "an", "othan", "neve",
    "belial", "belsa", "elsa", "lood","cycla",
    "paus", "persis", "reor", "deleo", "insid",
    "const", "pas", "swil", "cas", "defal", "repec", "voia"
  ],
  "operators": {
    "arithmetic": ["+", "-", "*", "/", "%"],
    "relational": ["==", "!=", "<", "<=", ">", ">="],
    "assignment": ["=", "+=", "-=", "*=", "/=", "%="],
    "logical": ["an", "othan", "neve"],
    "membership": ["insid"]
  },
  "comments": {
    "pairedComment": "~"
  },
  "constraints": {
    "identifier": {
      "minLengthVariable": 1,
      "minLengthFunction": 3,
      "maxLength": 20,
      "regex": "[a-zA-Z][a-zA-Z0-9_]*"
    },
    "wharfaLiteral": {
      "maxSignificantDigits": 8,
      "minValue": -99999999,
      "maxValue": 99999999
    },
    "recursionDepthMax": 999
  },
  "syntax": {
    "reservedWords": [
      "strina",
      "wharfa",
      "trua",
      "lis",
      "glossare",
      "prin",
      "inpub",
      "formo",
      "innum",
      "Trua",
      "Inaccu",
      "an",
      "othan",
      "neve",
      "belial",
      "belsa",
      "elsa",
      "lood",
      "cycla",
      "paus",
      "persis",
      "reor",
      "deleo",
      "insid",
      "const",
      "pas",
      "flo",
      "inflo",
      "swil",
      "cas",
      "defal",
      "repec",
      "voia"
    ],
    "literals": {
      "booleans": ["Trua", "Inaccu"],
      "null": []
    },
    "symbols": [
      "+",
      "-",
      "*",
      "/",
      "%",
      "==",
      "!=",
      "<",
      "<=",
      ">",
      ">=",
      "=",
      "+=",
      "-=",
      "*=",
      "/=",
      "%=",
      ":"
    ],
    "delimiters": {
      "separators": [",", ";", "(", ")", "[", "]", "{", "}"],
      "pairs": [
        { "open": "(", "close": ")" },
        { "open": "[", "close": "]" },
        { "open": "{", "close": "}" }
      ]
    },
    "comments": {
      "paired": "~"
    },
    "strings": {
      "quotes": ["\"", "'"],
      "escape": "\\",
      "validEscapes": ["\\\"", "\\'", "\\\\", "\\n", "\\t", "\\0", "\\{", "\\}"]
    }
  },
  "theme": {
    "reservedWord": "#c678dd",
    "symbol": "#56b6c2",
    "delimiter": "#e5c07b",
    "string": "#98c379",
    "number": "#d19a66",
    "comment": "#5c6370",
    "stringEscape": "#e06c75",
    "formatPlaceholder": "#61afef"
  }
}
